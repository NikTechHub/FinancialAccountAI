# Local development settings for docker compose.
#
# 1. Copy this file to .env:  cp .env.example .env
# 2. Replace every value containing "change-me" or "replace-with".
# 3. Never commit .env (it is gitignored) and never reuse these values in production.
#
# The Compose stack is for local development only. For production use a secrets
# manager / orchestration platform, TLS for MySQL/Kafka/Redis, and external
# managed services or a properly operated cluster.

# Application profile used by the Compose app container. The Compose stack is a
# local/dev stack; production settings are documented in README.md.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL (published to the host on 127.0.0.1 for local tools)
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_HOST_PORT=3306
DB_HOST=mysql
DB_PORT=3306
DB_NAME=accounting_db
DB_USERNAME=accounting
DB_PASSWORD=change-me-app-db-password

# JWT. Generate a strong production value with:
#   openssl rand -base64 48
# A development placeholder is acceptable only for the local dev profile.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Redis is optional. Set REDIS_ENABLED=true to use the Compose Redis service.
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_HOST_PORT=6379

# Kafka (advertised to host clients as localhost:29092)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=29092

# AI provider. Leave the dummy/placeholder key to use deterministic fallback
# extraction without external calls. Put a real key only in your local .env or
# a production secrets manager.
SPRING_AI_PROVIDER=openai
SPRING_AI_MODEL=gpt-4o-mini
SPRING_AI_API_KEY=replace-with-your-ai-provider-api-key

# Document storage (the Compose stack mounts a named volume at this path)
DOCUMENT_STORAGE_PATH=/data/documents
DOCUMENT_MAX_FILE_SIZE=10MB

# Comma-separated explicit browser origins. Empty means CORS is disabled.
# Wildcards are rejected. Example: https://app.example.com
APP_CORS_ALLOWED_ORIGINS=

# JVM options for the app container
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0 -XX:+ExitOnOutOfMemoryError
